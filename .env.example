MEDIABIAS_MODE=demo
MEDIABIAS_DATABASE_URL=sqlite:///./var/mediabias.db
# Replace both placeholder token KEYS with independently generated secrets.
# Values are server-controlled identities. Never commit your real .env.
MEDIABIAS_USERS={}
# Live example:
# MEDIABIAS_MODE=live
# MEDIABIAS_USERS={"replace-with-unique-reviewer-token":{"id":"reviewer-1","role":"reviewer"},"replace-with-unique-editor-token":{"id":"editor-1","role":"editor"}}
MEDIABIAS_LLM_BASE_URL=https://api.openai.com/v1
MEDIABIAS_LLM_API_KEY=
MEDIABIAS_LLM_MODEL=
MEDIABIAS_VERIFIER_MODEL=
MEDIABIAS_LLM_CONCURRENCY=2
MEDIABIAS_HTTP_CONCURRENCY=5
MEDIABIAS_COLLECTOR_MODE=api
MEDIABIAS_POLL_SECONDS=600
# [] uses all enabled sources; an explicit list narrows collection.
MEDIABIAS_ACTIVE_SOURCE_IDS=[]
MEDIABIAS_MAX_ARTICLE_CHARS=10000
MEDIABIAS_MAX_EVENT_ARTICLES=25
